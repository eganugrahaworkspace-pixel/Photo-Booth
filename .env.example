# The Vercel Blob store must be created with Private access (cannot be changed later).
# It must also be created in Singapore (sin1), to match the function region in vercel.json.
BLOB_READ_WRITE_TOKEN=
BOOTH_KEY=
CRON_SECRET=
# Build-time (Vite): the public production origin the QR codes point to, e.g. https://photos.example.com.
# Must be the public production domain, not a preview URL (previews sit behind a login).
# Leave empty only for local dev; a production build without a valid https URL blocks shooting.
VITE_PUBLIC_ORIGIN=
